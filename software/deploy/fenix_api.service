# ─────────────────────────────────────────────────────────────────────────
#  Este archivo está versionado en el repositorio, en software/deploy/.
#  Systemd lee la copia de /etc/systemd/system/, no esta.
#
#  Si lo modificas en el servidor, copia el cambio también al repo
#  (ver software/deploy/README.md) o el respaldo quedará desactualizado.
#  Tras cualquier cambio: systemctl daemon-reload && systemctl restart ...
# ─────────────────────────────────────────────────────────────────────────
[Unit]
Description=Fenix Telemetry API
After=network.target fenix_backend.service

[Service]
User=fenix
EnvironmentFile=/opt/fenix/software/Backend/.env
WorkingDirectory=/opt/fenix/software/Backend
ExecStart=/opt/fenix/venv/bin/python -m uvicorn fenix_api:app --host 0.0.0.0 --port 8050
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
