# Plantilla de configuración del backend.
#
# Copia este archivo a .env en el servidor y rellena los valores reales:
#
#     cp .env.example .env
#     nano .env
#
# El .env NUNCA se versiona (está en .gitignore). Este archivo sí, por eso
# no debe contener ningún valor real: solo placeholders.
#
# Los servicios systemd lo cargan con EnvironmentFile=; ver software/deploy/.

# ── MQTT ──
FENIX_MQTT_HOST=localhost
FENIX_MQTT_PORT=1883
FENIX_MQTT_USER=CAMBIAR
FENIX_MQTT_PASS=CAMBIAR

# ── InfluxDB ──
FENIX_INFLUX_URL=http://localhost:8086
FENIX_INFLUX_TOKEN=CAMBIAR
FENIX_INFLUX_ORG=Escuderia Fenix UPIITA
FENIX_INFLUX_BUCKET=Telemetria

# ── fenix_api (WebSocket hacia el Frontend) ──
FENIX_API_INTERNAL_URL=http://localhost:8050/internal/snapshot

# ── Servidor HTTP de /set_meta, /session_summary, /sessions_for_date ──
FENIX_META_HTTP_PORT=8060

# ── Token de acceso para setear la línea de meta (POST /set_meta) ──
# El frontend lo envía por header X-Meta-Token.
# Conviene cambiarlo antes de cada temporada o competencia: si alguien lo
# captura en un evento, deja de servirle al siguiente.
FENIX_META_TOKEN=CAMBIAR

# ── CORS (lista separada por comas) ──
# Qué páginas web pueden leer la API desde un navegador. La respetan tanto
# fenix_api.py (8050) como meta_server.py (8060).
# Si se deja vacío, acepta cualquier origen (*) y avisa en el arranque.
# Incluye TODAS las formas en que el equipo abre el dashboard: si alguien
# entra por una IP o puerto que no esté aquí, el navegador le bloqueará las
# peticiones aunque la página cargue.
# Ejemplo: FENIX_ALLOWED_ORIGINS=http://23.94.237.163:8080,http://localhost:8080
FENIX_ALLOWED_ORIGINS=
