#pragma once
// ─────────────────────────────────────────────────────────────────────────
//  secrets.h — Credenciales del firmware (PLANTILLA)
// ─────────────────────────────────────────────────────────────────────────
//
//  Este archivo (.example) SÍ se versiona: documenta qué constantes hay que
//  definir, sin revelar sus valores.
//
//  El secrets.h real NO se versiona (está en .gitignore). Para compilar:
//
//      cd firmware/MGT_firmware/include
//      cp secrets.h.example secrets.h
//      # y rellenar los cuatro valores
//
//  Si falta secrets.h, la compilación falla con
//  "fatal error: secrets.h: No such file or directory" — es la señal de que
//  hay que crearlo, no de que el repositorio esté roto.
//
//  Guarda una copia de tus valores fuera del repo (gestor de contraseñas):
//  si se pierde el secrets.h local, no hay forma de recuperarlo desde git.
// ─────────────────────────────────────────────────────────────────────────

// ── Red WiFi a la que se conecta el ESP32 ──
#define SECRET_WIFI_SSID   "CAMBIAR"
#define SECRET_WIFI_PASS   "CAMBIAR"

// ── Broker MQTT ──
// Deben coincidir con el usuario/contraseña de mosquitto en el servidor y
// con FENIX_MQTT_USER / FENIX_MQTT_PASS del .env del Backend: los dos
// extremos se autentican contra el mismo broker.
#define SECRET_MQTT_USER   "CAMBIAR"
#define SECRET_MQTT_PASS   "CAMBIAR"
